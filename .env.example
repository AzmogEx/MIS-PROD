# Générer un secret unique (>=32 caractères) ; ne jamais réutiliser un secret de test.
PAYLOAD_SECRET=
DATABASE_URL=file:./.data/cms.db
CMS_SCHEMA_PUSH=false
CMS_DEPLOYMENT_ENVIRONMENT=production
CMS_IMAGE_NAME=mis-production-cms
CMS_IMAGE_TAG=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
MEDIA_MAX_BYTES=104857600
CMS_MEDIA_DIR=.data/media
MEDIA_STORAGE_MAX_BYTES=10737418240
CMS_PRIVATE_FILES_DIR=.cms/private
CMS_PRIVATE_UPLOAD_MAX_BYTES=262144000
CMS_PRIVATE_STORAGE_MAX_BYTES=10737418240
CMS_BRIEF_FILES_DIR=.data/brief-files
CMS_BRIEF_STORAGE_MAX_BYTES=1073741824
MEDIA_IMPORT_ROOT=.data/media-imports
MEDIA_IMPORT_STORAGE_MAX_BYTES=2147483648
MEDIA_IMPORT_TTL_SECONDS=86400
# Un seul worker, observations datées privées et arrêt d'un passage trop long.
CMS_WORKER_HEALTH_DIR=.data/health
CMS_WORKER_RUN_TIMEOUT_MS=600000
CMS_EMAIL_DELIVERY=disabled
CMS_AUTH_EMAIL_DELIVERY=disabled
CMS_BROWSER_ANALYTICS=disabled
# Politique de conservation : 0 = conserver, aucun effacement par défaut.
# Voir cms:retention (aperçu) avant activation explicite.
CMS_RETENTION_ENABLED=disabled
CMS_RETENTION_ANALYTICS_DAYS=0
CMS_RETENTION_AUDIT_DAYS=0
CMS_RETENTION_BRIEF_DAYS=0
# Provider facultatif, uniquement après autorisation explicite d’envoi réel :
RESEND_API_KEY=
CONTACT_SENDER=
# IA locale uniquement. Modèle et quotas : /admin/globals/ai-settings
OLLAMA_BASE_URL=
# Transcription facultative vers whisper.cpp déjà lancé en boucle locale.
# Aucun téléchargement de modèle. Voir docs/cms/TRANSCRIPTION-LOCALE.md.
WHISPER_BASE_URL=
WHISPER_MODEL=
WHISPER_CONVERT_ENABLED=false
WHISPER_MAX_AUDIO_BYTES=26214400
WHISPER_MAX_AUDIO_SECONDS=900
WHISPER_TIMEOUT_MS=180000
# Search Console en lecture seule, aucun appel sans activation explicite.
CMS_SEARCH_CONSOLE=disabled
GOOGLE_SEARCH_CONSOLE_PROPERTY=
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=
# Voir docs/cms/EXPLOITATION.md avant toute activation de fournisseur.
